{
  "name": "aisummitmapper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && bun run typecheck",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bunx --bun tsrs --noEmit",
    "test:security": "node scripts/security-braces.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "0.19.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@oxlint/plugins": "^1.89.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
